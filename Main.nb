      RowBox[{"fn1apprx", "[", "n", "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "1", ",", " ", "10"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
