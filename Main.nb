Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "k_", "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Sin", "[", 
       FractionBox["Pi", 
        RowBox[{"2", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "k"}], "+", "1"}], ")"}]}]], "]"}]}], ")"}], 
    RowBox[{
     RowBox[{"2", "k"}], "+", "1"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "k", "]"}], ",", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{"Pi", "/", "2"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "2", ",", " ", "10"}], "}"}]}], "]"}]}], "Input",
