Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fn1", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "n"}], "/", "2"}], "]"}], 
    FractionBox[
     SuperscriptBox["n", 
      RowBox[{"n", "/", "2"}]], 
     RowBox[{"Sqrt", "[", 
      RowBox[{"n", "!"}], "]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fn1apprx", "[", "n_", "]"}], ":=", 
   FractionBox["1", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "*", "Pi"}], ")"}], 
      RowBox[{"1", "/", "4"}]], 
     SuperscriptBox["n", 
      RowBox[{"1", "/", "4"}]]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
