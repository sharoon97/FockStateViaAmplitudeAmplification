Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "th_", "]"}], ":=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", "*", "2", "*", "th"}], "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", "*", "2", "*", "th"}], "]"}]}], ")"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cth", "[", "th_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"f", "[", "th", "]"}], "+", 
      RowBox[{"f", "[", 
       RowBox[{"-", "th"}], "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sth", "[", "th_", "]"}], ":=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "I"}]], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"f", "[", "th", "]"}], "-", 
       RowBox[{"f", "[", 
        RowBox[{"-", "th"}], "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"sth", "[", "th", "]"}], "\[IndentingNewLine]", 
    RowBox[{"Cot", "[", "th", "]"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"TrigReduce", "[", 
