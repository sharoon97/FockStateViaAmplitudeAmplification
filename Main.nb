             RowBox[{"(", 
              RowBox[{"ki", "+", "kx"}], ")"}], "*", "gam"}], ")"}]}], ")"}], 
         "+", "1"}]]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
