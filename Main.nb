 RowBox[{
  RowBox[{"(*", 
   RowBox[{"slightly", " ", "different", " ", "loss", " ", "function"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ploss", "[", 
