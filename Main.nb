        RowBox[{"Sin", "[", 
         FractionBox["Pi", 
          RowBox[{"2", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "k"}], "+", "1"}], ")"}]}]], "]"}], "2"]}], "+", 
      " ", 
      RowBox[{"4", 
       RowBox[{"(", "k", ")"}], "*", "kx", "*", 
       FractionBox["gam", 
        SuperscriptBox["g", "2"]]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ploss0", "[", 
