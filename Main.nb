      "]"}], ":=", " ", 
     RowBox[{"1", "-", 
      RowBox[{
       FractionBox["kx", 
        RowBox[{"ki", "+", "kx"}]], "*", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["g", "2"], "/", 
